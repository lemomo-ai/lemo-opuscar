 "subs": [
  {
   "id": "ad",
   "t0": 0.158,
   "t1": 2.177,
   "zh": "是兄弟，就来砍我！",
   "en": "If you're my brother, come and fight me!"
  },
  {
   "id": "q1",
   "t0": 2.783,
   "t1": 5.097,
   "zh": "你点这一下，游戏公司要付两百块。",
   "en": "This one tap of yours costs the game company two hundred yuan."
  },
  {
   "id": "q2",
   "t0": 5.117,
   "t1": 7.68,
   "zh": "凭什么？这门生意只算一道题：",
   "en": "Why pay that? The whole business is one sum:"
  },
  {
   "id": "q3",
   "t0": 7.7,
   "t1": 9.763,
   "zh": "买你的钱，得少于你充的钱。",
   "en": "what it pays for you must be less than what you top up."
  },
  {
   "id": "a1",
   "t0": 9.783,
   "t1": 11.638,
   "zh": "可十个人里，大概就一个充钱。",
   "en": "But only about one player in ten ever pays."
  },
  {
   "id": "a2",
   "t0": 11.658,
   "t1": 13.055,
   "zh": "那就让这一个，多充点。",
   "en": "So that one has to pay more."
  },
  {
   "id": "a3",
   "t0": 13.075,
   "t1": 14.93,
   "zh": "六块首充，先让你掏一次钱包；",
   "en": "A six-yuan first top-up gets your wallet open once;"
  },
  {
   "id": "a4",
   "t0": 14.95,
   "t1": 16.805,
   "zh": "排行榜，再让大哥越充越多。",
   "en": "the leaderboard keeps the big spenders paying more and more."
  },
  {
   "id": "a5",
   "t0": 16.825,
   "t1": 19.597,
   "zh": "有家公司，付费玩家平均每月充四百多。",
   "en": "At one company, paying players top up over 400 yuan a month on average."
  },
  {
   "id": "a6",
   "t0": 19.617,
   "t1": 22.68,
   "zh": "不充钱的你也有用：大哥砍人，得有人看。",
   "en": "Free players are useful too: when big spenders cut people down, someone has to watch."
  },
  {
   "id": "b1",
   "t0": 22.7,
   "t1": 25.263,
   "zh": "可两周后，人走光了，大哥没人砍了。",
   "en": "But two weeks later everyone's gone, and the big spenders have no one to cut."
  },
  {
   "id": "b2",
   "t0": 25.283,
   "t1": 28.763,
   "zh": "那就开新服：回到一级，重新冲榜，再充一遍。",
   "en": "So open a new server: back to level 1, race up the board again, pay all over again."
  },
  {
   "id": "b3",
   "t0": 28.783,
   "t1": 30.638,
   "zh": "老服没人了，就合在一起。",
   "en": "When the old servers empty out, merge them into one."
  },
  {
   "id": "c1",
   "t0": 30.658,
   "t1": 32.972,
   "zh": "可新服要新人，新人又得花钱买。",
   "en": "But new servers need new players, and new players cost money."
  },
  {
   "id": "c2",
   "t0": 32.992,
   "t1": 36.013,
   "zh": "有家公司，收入六到八成花在推广，就是去买下一个你。",
   "en": "One company spends 60 to 80 percent of its revenue on promotion: buying the next you."
  },
  {
   "id": "c3",
   "t0": 36.033,
   "t1": 38.138,
   "zh": "回得了本，这个圈就一直转。",
   "en": "As long as it pays back, the loop keeps turning."
  },
  {
   "id": "d1",
   "t0": 38.158,
   "t1": 40.93,
   "zh": "买人这么贵，广告不能浪费在不充钱的人身上。",
   "en": "Players cost so much that ads can't be wasted on people who won't pay."
  },
  {
   "id": "d2",
   "t0": 40.95,
   "t1": 44.472,
   "zh": "所以它故意这么土：嫌土的划走，留下的才会充钱。",
   "en": "So it's tacky on purpose: whoever cringes swipes away, whoever stays will pay."
  },
  {
   "id": "d3",
   "t0": 44.492,
   "t1": 47.929,
   "zh": "请明星？那笔钱只占预算的零点几个百分点。",
   "en": "A celebrity? That costs a fraction of one percent of the budget."
  },
  {
   "id": "e1",
   "t0": 50.117,
   "t1": 51.513,
   "zh": "所以，别笑它土。",
   "en": "So don't laugh at how tacky it is."
  },
  {
   "id": "e2",
   "t0": 51.533,
   "t1": 54.373,
   "zh": "它不是做给所有人看的，是做给会充钱的你。",
   "en": "It isn't made for everyone. It's made for you, the one who pays."
  }
 ],
