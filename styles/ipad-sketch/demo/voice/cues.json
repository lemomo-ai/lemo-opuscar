 "cues": [
  {
   "id": "v01",
   "t0": 0.5,
   "t1": 3.3500000000000005,
   "zh": "这是一杯咖啡。",
   "en": "This is a cup of coffee.",
   "spoken": 1.987
  },
  {
   "id": "v02",
   "t0": 3.4000000000000004,
   "t1": 7.0,
   "zh": "可它最初，是一颗果子的种子。",
   "en": "But it began as the seed of a fruit.",
   "spoken": 2.813
  },
  {
   "id": "v03a",
   "t0": 7.05,
   "t1": 9.849999999999998,
   "zh": "咖啡果长在枝头，",
   "en": "Coffee cherries ripen on the branch,",
   "spoken": 2.1
  },
  {
   "id": "v03b",
   "t0": 9.899999999999999,
   "t1": 12.7,
   "zh": "由绿慢慢熟成红色。",
   "en": "from green to red.",
   "spoken": 2.1969999999999996
  },
  {
   "id": "v04",
   "t0": 12.75,
   "t1": 17.0,
   "zh": "剖开一颗：两粒种子，面对面。",
   "en": "Cut one open: two seeds, face to face.",
   "spoken": 3.457
  },
  {
   "id": "v05a",
   "t0": 17.05,
   "t1": 20.39,
   "zh": "果子整颗在太阳下晒干，",
   "en": "The cherries dry whole in the sun,",
   "spoken": 2.64
  },
  {
   "id": "v05b",
   "t0": 20.44,
   "t1": 22.832,
   "zh": "再把干了的果壳剥掉。",
   "en": "then the husk comes off.",
   "spoken": 1.7419999999999995
  },
  {
   "id": "v06",
   "t0": 22.9,
   "t1": 26.585,
   "zh": "这就是生豆。一点也不像咖啡。",
   "en": "Green beans. Nothing like coffee yet.",
   "spoken": 2.785
  },
  {
   "id": "v07",
   "t0": 26.7,
   "t1": 30.578000000000003,
   "zh": "然后加热。黄色，肉桂色，棕色。",
   "en": "Then, heat. Yellow. Cinnamon. Brown.",
   "spoken": 2.978
  },
  {
   "id": "v08a",
   "t0": 30.63,
   "t1": 33.730000000000004,
   "zh": "到 196 °C 上下，",
   "en": "Near 196 °C,",
   "spoken": 2.4
  },
  {
   "id": "v08b",
   "t0": 33.78,
   "t1": 36.32,
   "zh": "豆子噼啪裂开，像爆米花。",
   "en": "they crack, like popcorn.",
   "spoken": 1.8900000000000001
  },
  {
   "id": "v09",
   "t0": 36.7,
   "t1": 40.003,
   "zh": "磨成粉，遇上热水，",
   "en": "Ground, and met with hot water,",
   "spoken": 2.403
  },
  {
   "id": "v10",
   "t0": 40.1,
   "t1": 44.535000000000004,
   "zh": "一颗樱桃的种子，就成了一杯咖啡。",
   "en": "the seed of a cherry becomes a cup of coffee.",
   "spoken": 3.535
  }
