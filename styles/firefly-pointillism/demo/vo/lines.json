[
 {
  "id": "v1_0",
  "text": "On summer nights,",
  "voice": "af_bella",
  "speed": 0.82
 },
 {
  "id": "v1_1",
  "text": "a firefly's blink is a question.",
  "voice": "af_bella",
  "speed": 0.82
 },
 {
  "id": "v2_0",
  "text": "When one answers,",
  "voice": "af_bella",
  "speed": 0.8
 },
 {
  "id": "v2_1",
  "text": "thousands blink back, all at once.",
  "voice": "af_bella",
  "speed": 0.8
 },
 {
  "id": "v3_0",
  "text": "That night, the answer had antlers.",
  "voice": "af_bella",
  "speed": 0.8
 },
 {
  "id": "v4_0",
  "text": "It carried her past the edge",
  "voice": "af_bella",
  "speed": 0.76
 },
 {
  "id": "v4_1",
  "text": "of everything she knew.",
  "voice": "af_bella",
  "speed": 0.76
 },
 {
  "id": "v5_0",
  "text": "Then the storm came,",
  "voice": "af_bella",
  "speed": 0.78
 },
 {
  "id": "v5_1",
  "text": "and every light went out.",
  "voice": "af_bella",
  "speed": 0.76
 },
 {
  "id": "v6_0",
  "text": "Except for one.",
  "voice": "af_bella",
  "speed": 0.84
 },
 {
  "id": "v7_0",
  "text": "So she held it up,",
  "voice": "af_bella",
  "speed": 0.76
 },
 {
  "id": "v7_1",
  "text": "and asked.",
  "voice": "af_bella",
  "speed": 0.76
 },
 {
  "id": "v8_0",
  "text": "And the whole dark answered.",
  "voice": "af_bella",
  "speed": 0.72
 },
 {
  "id": "v9_0",
  "text": "Shine,",
  "voice": "af_bella",
  "speed": 0.76
 },
 {
  "id": "v9_1",
  "text": "and someone will shine back.",
  "voice": "af_bella",
  "speed": 0.76
 }
]