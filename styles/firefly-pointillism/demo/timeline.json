 "cues": [
  {
   "t0": 0.58,
   "t1": 4.991,
   "zh": "夏夜里，萤火虫闪一下，就是在发问。",
   "en": "On summer nights, a firefly's blink is a question.",
   "speech": 3.641
  },
  {
   "t0": 5.08,
   "t1": 9.884,
   "zh": "有一只回答，成千上万只就一起闪回来。",
   "en": "When one answers, thousands blink back, all at once.",
   "speech": 4.034
  },
  {
   "t0": 10.08,
   "t1": 13.325,
   "zh": "那天晚上，回答长着鹿角。",
   "en": "That night, the answer had antlers.",
   "speech": 2.475
  },
  {
   "t0": 16.28,
   "t1": 20.773,
   "zh": "它驮着她，走出了她认得的一切。",
   "en": "It carried her past the edge of everything she knew.",
   "speech": 3.723
  },
  {
   "t0": 22.08,
   "t1": 26.493,
   "zh": "后来暴风雨来了，所有的光都灭了。",
   "en": "Then the storm came, and every light went out.",
   "speech": 3.643
  },
  {
   "t0": 28.48,
   "t1": 30.38,
   "zh": "只剩下一只。",
   "en": "Except for one.",
   "speech": 1.055
  },
  {
   "t0": 30.63,
   "t1": 34.069,
   "zh": "她把它高高举起，问了一声。",
   "en": "So she held it up, and asked.",
   "speech": 2.669
  },
  {
   "t0": 35.48,
   "t1": 38.188,
   "zh": "整片黑夜都回答了。",
   "en": "And the whole dark answered.",
   "speech": 1.938
  },
  {
   "t0": 42.28,
   "t1": 46.105,
   "zh": "你亮一下，就会有人亮回来。",
   "en": "Shine, and someone will shine back.",
   "speech": 3.055
  }
 ]
}