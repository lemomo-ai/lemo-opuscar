#!/usr/bin/env bash
# opuscar — run this repo's renderers on a GPU-less Linux box (cloud VM / CI runner).
#
# It pins the two things `node core/render/*.mjs` needs there and cannot infer:
#
#   1) PLAYWRIGHT_CHROME — the hard blocker, and it is not WebGL-specific: playwright-core
#      asks for the exact browser build it was pinned to, so a box whose
#      ~/.cache/ms-playwright holds any other build aborts at launch() with "Executable
#      doesn't exist" for *every* style.  Measured here: cache had chromium-1217/1223,
#      playwright-core wanted chromium_headless_shell-1243 — ascii-crt (WebGL) and
#      swiss-motion (2D canvas) both exited 1 with no file written.  The wrapper picks the
#      newest local build, preferring chrome-headless-shell.
#   2) LEMO_ANGLE — belt-and-braces, and only load-bearing *before* PR #35 lands.  On
#      current main, `node core/render/still.mjs styles/ascii-crt/demo 39.4` with no
#      LEMO_ANGLE writes a 13 KB white frame (YAVG 254.996, SSIM Y 0.0515 against the
#      correct frame) and still exits 0 — 3/3 runs, deterministic.  The cause is not the
#      missing backend: it is `--enable-gpu --ignore-gpu-blocklist` being sent even when
#      no backend is pinned, which is exactly what PR #35 fixes.  With that patch applied
#      and LEMO_ANGLE still unset, the same command renders the real frame (504 KB,
#      YAVG 23.24, SSIM Y 0.99965) — 3/3.  So once #35 is in, this pin is redundant on
#      Linux; the wrapper keeps it because it costs nothing and makes the backend explicit
#      in the banner.
#
# Usage:
#   opuscar core/render/video.mjs styles/ascii-crt/demo --fps 24 --workers 3 --out /tmp/x.mp4
#   opuscar core/render/still.mjs  styles/ascii-crt/demo 39.4 --q 'nosub=1' --out /tmp/s
#
# Anything already exported in the shell wins, so `LEMO_ANGLE=metal opuscar ...` still
# works on macOS.  OPUSCAR_QUIET=1 silences the one-line banner.
set -euo pipefail

# Repo root: derived from this script's location, overridable for odd layouts.
# Follow symlinks first: the common install is a link in /usr/local/bin, and
# dirname on the link would make the root /usr/local.  readlink -f is absent on
# macOS, so walk the chain by hand.
SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do
  LINK="$(readlink -- "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
     *) SELF="$(cd -- "$(dirname -- "$SELF")" && pwd)/$LINK" ;;
  esac
done
REPO="${OPUSCAR_REPO:-$(cd -- "$(dirname -- "$SELF")/.." && pwd)}"

# --- 1. graphics backend --------------------------------------------------
if [[ -z "${LEMO_ANGLE:-}" ]]; then
  if [[ "$(uname -s)" == "Darwin" ]]; then LEMO_ANGLE=metal
  else LEMO_ANGLE=swiftshader; fi
fi
export LEMO_ANGLE

# --- 2. chromium executable ----------------------------------------------
if [[ -z "${PLAYWRIGHT_CHROME:-}" ]]; then
  CAND=""
  for d in "${PLAYWRIGHT_BROWSERS_PATH:-}" "${HOME:-/root}/.cache/ms-playwright" /root/.cache/ms-playwright; do
    [[ -n "$d" && -d "$d" ]] || continue
    # newest build first; chrome-headless-shell is preferred over full chromium
    while read -r f; do [[ -x "$f" ]] && { CAND="$f"; break; }; done < <(
      ls -d "$d"/chromium_headless_shell-*/chrome-headless-shell-linux64/chrome-headless-shell \
            "$d"/chromium-*/chrome-linux/chrome \
            "$d"/chromium-*/chrome-linux64/chrome 2>/dev/null | sort -t- -k2 -rn)
    [[ -n "$CAND" ]] && break
  done
  if [[ -z "$CAND" ]]; then
    for f in /usr/bin/chromium-browser /usr/bin/chromium /usr/bin/google-chrome /snap/bin/chromium; do
      [[ -x "$f" ]] && { CAND="$f"; break; }
    done
  fi
  if [[ -n "$CAND" ]]; then
    export PLAYWRIGHT_CHROME="$CAND"
  else
    echo "opuscar: no chromium found; run 'npx playwright install chromium-headless-shell'" >&2
    exit 127
  fi
fi

# --- 3. the repo's python venv (tts, mix, score) -------------------------
[[ -x "$REPO/.venv/bin/python" ]] && export PATH="$REPO/.venv/bin:$PATH"

[[ "${OPUSCAR_QUIET:-0}" == "1" ]] || \
  echo "[opuscar] LEMO_ANGLE=$LEMO_ANGLE  chrome=$(basename "$(dirname "$(dirname "$PLAYWRIGHT_CHROME")")")" >&2

cd "$REPO"
case "${1:-}" in
  ""|-h|--help) echo "usage: opuscar <script.mjs|command> [args...]   (cwd = $REPO)"; exit 0 ;;
  *.mjs|*.js)   exec node "$@" ;;
  *.py)         exec python "$@" ;;
  *)            exec "$@" ;;
esac
